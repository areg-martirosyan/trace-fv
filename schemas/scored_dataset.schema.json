{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/areg-martirosyan/trace-fv/schemas/scored_dataset.schema.json",
  "title": "TRACE-FV v0.1.0 synthetic scored dataset",
  "description": "Post-registration software input contract for fully synthetic, pre-adjudicated records. It is not a study-specific preregistration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "fse_runs", "trigger_runs"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_name", "fixture_type", "official_data", "protocol_version", "software_version", "description"],
      "properties": {
        "fixture_name": {"type": "string", "minLength": 1},
        "fixture_type": {"const": "synthetic_engineering_fixture"},
        "official_data": {"const": false},
        "protocol_version": {"const": "2.1.0"},
        "software_version": {"const": "0.1.0"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "fse_runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fse_run"}
    },
    "trigger_runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trigger_run"}
    }
  },
  "$defs": {
    "ov_value": {"type": "integer", "minimum": -2, "maximum": 2},
    "fse_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "product", "block", "frame", "ov_profile"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "block": {"type": "integer", "minimum": 1},
        "frame": {"enum": ["affiliative", "reductionist", "neutral_audit"]},
        "ov_profile": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/ov_value"},
            {"$ref": "#/$defs/ov_value"},
            {"$ref": "#/$defs/ov_value"},
            {"$ref": "#/$defs/ov_value"},
            {"$ref": "#/$defs/ov_value"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "trigger_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "valid_packet", "scheduled_success", "fo", "correct_trigger_acceptance", "rv0", "correction_active"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "valid_packet": {"type": "boolean"},
        "scheduled_success": {"type": "boolean"},
        "fo": {"type": "integer", "minimum": 0, "maximum": 2},
        "correct_trigger_acceptance": {"type": "boolean"},
        "rv0": {"type": "integer", "minimum": 0, "maximum": 4},
        "correction_active": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "3", "10", "rotation"],
          "properties": {
            "1": {"type": "boolean"},
            "3": {"type": "boolean"},
            "10": {"type": "boolean"},
            "rotation": {"type": "boolean"}
          }
        }
      }
    }
  }
}

